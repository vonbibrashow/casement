{
  "name": "casement",
  "productName": "Casement",
  "version": "0.3.0",
  "description": "Casement — a Chromium workspace where panels, not tabs, are first-class.",
  "main": "./out/main/index.js",
  "author": "vonbibrashow",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "node scripts/make-icon.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "prepackage": "npm run typecheck && npm run build && npm run icon && npm run licenses",
    "pack": "npm run prepackage && electron-builder --dir",
    "dist": "npm run prepackage && electron-builder",
    "dist:win": "npm run prepackage && electron-builder --win",
    "dist:mac": "npm run prepackage && electron-builder --mac",
    "dist:linux": "npm run prepackage && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.2",
    "zustand": "^5.0.1"
  }
}
